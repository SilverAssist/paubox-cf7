{
    "name": "silverassist/paubox-cf7",
    "description": "Integrates Contact Form 7 with the Paubox encrypted email API.",
    "type": "wordpress-plugin",
    "license": "Polyform-Noncommercial-1.0.0",
    "authors": [
        {
            "name": "Silver Assist",
            "email": "info@silverassist.com",
            "homepage": "https://silverassist.com"
        }
    ],
    "homepage": "https://github.com/SilverAssist/paubox-cf7",
    "support": {
        "issues": "https://github.com/SilverAssist/paubox-cf7/issues",
        "source": "https://github.com/SilverAssist/paubox-cf7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "silverassist/wp-plugin-kernel": "^1.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "miguelcolmenares/cf7-stubs": "^6.1",
        "php-stubs/wordpress-stubs": "^6.6",
        "php-stubs/wordpress-tests-stubs": "^7.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "silverassist/wp-coding-standards": "^1.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SilverAssist\\PauboxCF7\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverAssist\\PauboxCF7\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "lint": "@phpcs",
        "lint:fix": "@phpcbf",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse includes/ --level=8",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ],
        "install:dev": "composer install --optimize-autoloader",
        "install:prod": "composer install --no-dev --optimize-autoloader"
    },
    "extra": {
        "installer-name": "paubox-cf7"
    }
}
